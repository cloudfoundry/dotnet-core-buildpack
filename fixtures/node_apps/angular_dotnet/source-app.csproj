<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <SpaRoot>ClientApp\</SpaRoot>
    <NpmInstallCommand>npm ci --include=dev --no-audit --no-fund --prefer-offline</NpmInstallCommand>
    <RootNamespace>source_app</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Don't publish the SPA source files, but do show them in the project files list -->
    <Content Remove="$(SpaRoot)**" />
    <None Remove="$(SpaRoot)**" />
    <None Include="$(SpaRoot)**" Exclude="$(SpaRoot)node_modules\**" />
  </ItemGroup>

  <Target Name="PublishRunWebpack" AfterTargets="ComputeFilesToPublish">
    <!-- Note: optimization=false skips heavy minification to stay within CF 15 min staging timeout -->
    <Exec WorkingDirectory="$(SpaRoot)" Command="$(NpmInstallCommand)" Condition="!Exists('$(SpaRoot)node_modules')" EnvironmentVariables="NODE_OPTIONS=--max-old-space-size=384" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build -- --configuration production --optimization=false" EnvironmentVariables="NODE_OPTIONS=--max-old-space-size=384;NG_BUILD_MAX_WORKERS=2" />

    <ItemGroup>
      <DistFiles Include="$(SpaRoot)dist\**" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
